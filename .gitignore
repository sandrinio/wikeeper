# Created by `cleargate init` because this repository had no .gitignore.
# This region is yours — edit freely; ClearGate will not rewrite it.

# Dependencies
node_modules/

# Build output
dist/
coverage/
*.tgz

# ClearGate off-sprint token ledger (machine-local usage data, contains home paths)
.cleargate/sprint-runs/_off-sprint/

# ClearGate sprint runtime state (machine-local, rewritten on every dispatch)
.cleargate/sprint-runs/.active
.cleargate/sprint-runs/*/state.json
.cleargate/sprint-runs/*/events.jsonl
.cleargate/sprint-runs/*/token-ledger.jsonl
.cleargate/sprint-runs/*/.session-totals.json
.cleargate/sprint-runs/*/.dispatch-*
.cleargate/sprint-runs/*/.processed-*
.cleargate/sprint-runs/*/.qa-context-*
.cleargate/sprint-runs/*/.script-incidents/
# Per-story agent reports: kept out of the tree during the sprint so the
# readiness check sees a clean checkout; committed with -f at sprint close.
.cleargate/sprint-runs/*/reports/
.cleargate/sprint-runs/*/.dev-handoff-*

# Local environment files (API keys, tokens, credentials).
# Allowlist lines must stay AFTER the .env patterns so the negation wins.
.env
.env.*
!.env.example
!.env.template

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# >>> cleargate >>>
# Managed by `cleargate init`. Edits inside this block are overwritten;
# everything outside it is yours and is never touched.

# Per-story git worktrees created by the sprint execution loop. Ephemeral:
# `git add -A` would otherwise stage one as an embedded git repository.
.worktrees/
# <<< cleargate <<<

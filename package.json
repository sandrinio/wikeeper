{
  "name": "wikeeper",
  "version": "0.3.0",
  "description": "A Karpathy-style LLM wiki that your AI coding agent keeps: gated ingest, cited facts, search. Works with Claude Code, Codex and Antigravity.",
  "keywords": [
    "llm",
    "wiki",
    "knowledge-base",
    "ai-agent",
    "claude-code",
    "codex",
    "antigravity",
    "agents-md",
    "cli"
  ],
  "license": "MIT",
  "author": "Sandro Suladze",
  "homepage": "https://github.com/sandrinio/wikeeper#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandrinio/wikeeper.git"
  },
  "bugs": {
    "url": "https://github.com/sandrinio/wikeeper/issues"
  },
  "type": "module",
  "bin": {
    "wikeeper": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-info.mjs dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude \"**/*-perf.red.node.test.ts\"",
    "test:perf": "vitest run --no-file-parallelism --exclude \"**/.worktrees/**\" test/search/search-perf.red.node.test.ts test/search/cache-perf.red.node.test.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "defuddle": "^0.19.5",
    "linkedom": "^0.18.13",
    "minisearch": "^7.2.0",
    "turndown": "^7.2.4",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}

# Generated by `cleargate init` — ClearGate runtime state, not team-shared.
# Paths are relative to .cleargate/. Safe to commit this file itself.

# Per-participant identity — contains a personal email address.
/.participant.json

# Per-machine sync + conflict state.
/.sync-marker.json
/.conflicts.json
/.comments-cache/

# Hook execution logs — record edited file paths and prompt fragments.
/hook-log/

# Regenerated dashboard snapshots (CR-084).
/sprint-runs/*/dashboard.html

# Background dashboard process record — pid/port, per-machine (CR-101).
/sprint-runs/*/.dashboard.json
